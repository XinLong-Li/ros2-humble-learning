<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>p09_turtle_control</name>
  <version>0.1.0</version>
  <description>ROS 2 Humble 学习示例 09：综合项目——用话题/服务/动作/参数/TF/launch 控制 turtlesim 乌龟</description>
  <maintainer email="li_xin_long@foxmail.com">Xinlong-Li</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>turtlesim</depend>
  <depend>p02_interfaces</depend>

  <!-- launch 文件与 rviz 配置在运行期才需要这些 -->
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
