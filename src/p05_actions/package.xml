<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>p05_actions</name>
  <version>0.1.0</version>
  <description>ROS 2 Humble 学习示例 05：动作 action（goal / feedback / result / cancel），对应 ROS 1 的 actionlib</description>
  <maintainer email="li_xin_long@foxmail.com">Xinlong-Li</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- 动作在 rclcpp 之外还需要 rclcpp_action（ROS 1 里是 actionlib） -->
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <!-- 动作接口 CountDown / NavigateTo 定义在 p02_interfaces -->
  <depend>p02_interfaces</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
